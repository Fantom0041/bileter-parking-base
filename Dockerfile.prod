FROM php:8.2-apache

# Install dependencies if needed (e.g. for pdo_mysql if you use it, or gd, intl etc.)
# For now keeping it minimal as per original, but good to have apt-get update
RUN apt-get update && rm -rf /var/lib/apt/lists/*

# Enable apache headers module if needed, but SSL is handled by proxy
RUN a2enmod headers rewrite

# Configure Apache to log to stdout/stderr (Docker standard)
# This is often default in php:apache images but good to be explicit or if we change conf
RUN echo '<VirtualHost *:80>\n\
  DocumentRoot /var/www/html\n\
  ErrorLog /proc/self/fd/2\n\
  CustomLog /proc/self/fd/1 combined\n\
  # Allow overriding via .htaccess if needed\n\
  <Directory /var/www/html>\n\
  Options Indexes FollowSymLinks\n\
  AllowOverride All\n\
  Require all granted\n\
  </Directory>\n\
  </VirtualHost>' > /etc/apache2/sites-available/000-default.conf

WORKDIR /var/www/html

COPY . /var/www/html

RUN chown -R www-data:www-data /var/www/html

# Use the default production configuration
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

EXPOSE 80
